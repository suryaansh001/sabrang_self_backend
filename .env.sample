# Sample Environment Configuration for User Synchronization
# Copy this to .env and update with your actual values

# MongoDB Connection
mongodb=mongodb://localhost:27017/sabrang

# Email Configuration (Choose one method)

# Method 1: Gmail with App Password (Recommended)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-digit-app-password

# Method 2: Custom SMTP Server
# SMTP_HOST=smtp.your-email-provider.com
# SMTP_PORT=587
# SMTP_USER=your-email@domain.com  
# SMTP_PASS=your-password

# Method 3: Generic Email (Fallback)
# EMAIL_USER=your-email@domain.com
# EMAIL_PASS=your-password

# Other Configuration
NODE_ENV=development
PORT=5000

# Instructions for Gmail App Password:
# 1. Go to Google Account settings
# 2. Security > 2-Step Verification (must be enabled)
# 3. App passwords > Generate app password
# 4. Use the 16-digit password (not your regular Gmail password)

# Instructions for Testing:
# 1. Set up your email credentials above
# 2. Run: node sync-users-comprehensive.js
# 3. Check console for email test results